  "upgradeRules": [
    {
      "id": "general_upgrade",
      "rule": "Equipable items are commonly upgraded to +9; some systems allow higher values. Upgrade attempts usually require Yang and upgrade materials.",
      "source": "https://en-wiki.metin2.gameforge.com/index.php/Upgrade_Items"
    },
    {
      "id": "npc_upgrade_risk",
      "rule": "NPC upgrades can destroy an item on failure depending on the upgrade method; refinement items can offer different failure outcomes.",
      "source": "https://en-wiki.metin2.gameforge.com/index.php/Upgrade_Items"
    },
    {
      "id": "refinement_vs_upgrade",
      "rule": "Craft/refinement materials and upgrade materials are related but not identical categories; some items can be used in both.",
      "source": "https://en-wiki.metin2.gameforge.com/index.php/Item_Refinement"
    },
    {
      "id": "spirit_stone_socket",
      "rule": "Spirit stones provide persistent equipment bonuses when successfully inserted into supported equipment; insertion can fail and leave a broken slot.",
      "source": "https://en-wiki.metin2.gameforge.com/index.php/Spirit_Stones"
    }
  ],
